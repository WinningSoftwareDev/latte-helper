{
  "name": "winningsoftware/latte-helper",
  "description": "An unofficial helper package for rendering Latte templates in Symfony applications.",
  "autoload": {
    "psr-4": {
      "LatteHelper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LatteHelper\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "latte/latte": "^3.0",
    "symfony/http-foundation": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/security-bundle": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.4",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.89"
  },
  "scripts": {
    "stan": "./vendor/bin/phpstan analyse --no-progress -c phpstan.neon",
    "unit": "php -d memory_limit=1G ./vendor/bin/phpunit --testdox --colors=always --coverage-text --coverage-clover=coverage.xml",
    "test": "php -d xdebug.mode=coverage ./vendor/bin/phpunit --testdox --colors=always --coverage-html coverage --coverage-clover coverage/coverage.xml --testdox-html coverage/testdox.html && composer badge",
    "cs": "./vendor/bin/php-cs-fixer fix --dry-run --diff --allow-risky=yes"
  },
  "license": "GPL-3.0-or-later"
}
